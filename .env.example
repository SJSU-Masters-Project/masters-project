# Django
DJANGO_SECRET_KEY=local-development-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_VERSION=dev

# Development authentication (never enable with DEBUG=false)
CAREERS_DEV_AUTH=true

# Clerk authentication (spec 04). For local sign-in in the portal, use the careers Clerk
# DEVELOPMENT instance; dev tokens (CAREERS_DEV_AUTH) still work for curl and tests.
# CLERK_ISSUER is the Clerk instance's Frontend API URL (e.g. https://your-app.clerk.accounts.dev).
# CLERK_JWKS_URL defaults to "<issuer>/.well-known/jwks.json" when left blank.
# CLERK_AUTHORIZED_PARTIES is a comma-separated list of the portal origins (the "azp" claim).
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# MongoDB (PyMongo; no Django ORM)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=career_portal

# Resume storage (spec 03): local | s3
RESUME_STORAGE=local
RESUME_LOCAL_ROOT=backend/var
# S3 settings (only when RESUME_STORAGE=s3)
RESUME_S3_BUCKET=
RESUME_S3_REGION=us-west-2

# Frontend (React + Vite)
VITE_API_URL=http://localhost:8000/api
