# Django
DJANGO_SECRET_KEY=local-development-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_VERSION=dev

# Development authentication (never enable with DEBUG=false)
CAREERS_DEV_AUTH=true

# MongoDB (PyMongo; no Django ORM)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=career_portal

# Resume storage (spec 03): local | s3
RESUME_STORAGE=local
RESUME_LOCAL_ROOT=backend/var
# S3 settings (only when RESUME_STORAGE=s3)
RESUME_S3_BUCKET=
RESUME_S3_REGION=us-west-2

# Frontend (React + Vite)
VITE_API_URL=http://localhost:8000/api
